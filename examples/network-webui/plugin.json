{
  "apiVersion": 1,
  "id": "com.example.muse.network-webui",
  "name": "网络 WebUI 示例",
  "version": "1.0.0",
  "author": "Muse Example",
  "description": "通过宿主安全网络代理获取 GitHub 公共 API 数据。",
  "entry": "index.js",
  "hooks": [],
  "permissions": [
    "network.request",
    "config",
    "player.read",
    "player.control",
    "queue.read",
    "queue.control",
    "library.read",
    "playlists.read",
    "lyrics.read",
    "stats.read",
    "theme.read",
    "theme.write",
    "equalizer.read",
    "equalizer.control",
    "profile.read"
  ],
  "network": {
    "allowHosts": ["api.github.com"]
  },
  "webUi": {
    "entry": "web/index.html"
  }
}
